<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Maintenance Portal - Akij Light Engineering Ltd.</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body { 
    font-family: 'Segoe UI', system-ui, -apple-system, sans-serif; 
    background: #0f172a; 
    color: #e2e8f0; 
    display: flex; 
    flex-direction: column; 
    align-items: center; 
    justify-content: center; 
    min-height: 100vh; 
  }
  .header { text-align: center; margin-bottom: 50px; }
  .header h1 { font-size: 36px; color: #60a5fa; font-weight: 700; margin-bottom: 12px; }
  .header p { color: #94a3b8; font-size: 16px; letter-spacing: 1px; }
  .card-container { 
    display: flex; 
    gap: 30px; 
    flex-wrap: wrap; 
    justify-content: center; 
    max-width: 900px; 
    width: 100%; 
    padding: 20px; 
  }
  .app-card { 
    background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%); 
    border: 2px solid #334155; 
    border-radius: 16px; 
    padding: 40px 30px; 
    text-align: center; 
    width: 100%; 
    max-width: 350px; 
    cursor: pointer; 
    transition: all 0.3s ease; 
    text-decoration: none; 
    display: flex; 
    flex-direction: column; 
    align-items: center; 
  }
  .app-card:hover { 
    transform: translateY(-8px); 
    border-color: #3b82f6; 
    box-shadow: 0 12px 25px rgba(59, 130, 246, 0.2); 
  }
  .app-card .icon { font-size: 56px; margin-bottom: 24px; }
  .app-card h2 { font-size: 22px; color: #e2e8f0; margin-bottom: 12px; }
  .app-card p { color: #94a3b8; font-size: 14px; line-height: 1.5; }
</style>
</head>
<body>

  <div class="header">
    <h1>Maintenance App Portal</h1>
    <p>AKIJ LIGHT ENGINEERING LTD.</p>
  </div>

  <div class="card-container">
    <!-- Option 1: Daily Maintenance Task -->
    <a href="daily_dashboard.html" class="app-card">
      <div class="icon">⚙️</div>
      <h2>Daily Maintenance Task</h2>
      <p>View routine maintenance logs, daily task breakdowns, and live machine statistics.</p>
    </a>

    <!-- Option 2: Preventive Maintenance -->
    <a href="#" class="app-card">
      <div class="icon">🛡️</div>
      <h2>Preventive Maintenance</h2>
      <p>Access scheduled machine servicing, preventive logs, and planned maintenance cycles.</p>
    </a>
  </div>

</body>
</html>
